+/// PhotoCraft's menus for a desktop's global menu bar that is not a Mac's: the same menus as the in-window bar, in the UI
+/// language, with Window and Help marked as such.
+pub fn plain_layout(items: &[MenuItem], lang: Lang) -> Layout {
+    let mut bar = from_items(&crate::menus::TOP_MENUS, items);
+    bar.tag_menu("Window", MenuRole::Window);
+    bar.tag_menu("Help", MenuRole::Help);
+    translate(&mut bar, lang);
+    Layout { bar, clashes: Vec::new() }
+}
